# Host tools for OS work on macOS. Install with `brew bundle`; check with `cargo xtask doctor`.
brew "qemu"            # emulator for x86_64, aarch64 and riscv64, with EDK2, SeaBIOS and OpenSBI firmware
brew "dtc"             # devicetree compiler, to read and write QEMU's device trees
brew "socat"           # connects to QEMU's serial, monitor and QMP sockets
brew "poppler"         # pdftotext, to turn the reference library's PDFs into searchable text
brew "acpica"          # iasl, to disassemble and compile ACPI tables
brew "x86_64-elf-gdb"  # debugger for x86_64 guests through QEMU's gdbstub
brew "aarch64-elf-gdb" # debugger for aarch64 guests through QEMU's gdbstub
brew "riscv64-elf-gdb" # debugger for riscv64 guests through QEMU's gdbstub
