{
  "permissions": {
    "allow": [
      "Bash(cargo xtask ci)",
      "Bash(cargo xtask ci --quick)",
      "Bash(cargo xtask test)",
      "Bash(cargo xtask test *)",
      "Bash(cargo xtask clippy)",
      "Bash(cargo xtask fmt --check)",
      "Bash(cargo xtask typos)",
      "Bash(cargo xtask doc)",
      "Bash(cargo xtask deny)",
      "Bash(cargo xtask check-workflows)",
      "Bash(cargo xtask check-settings)",
      "Bash(cargo xtask check-docs)",
      "Bash(cargo xtask doctor)",
      "Bash(cargo xtask refs)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(diskutil *)",
      "Bash(dd *)",
      "Bash(hdiutil *)",
      "Bash(launchctl *)",
      "Bash(tmutil *)",
      "Bash(csrutil *)",
      "Bash(nvram *)",
      "Bash(osascript *)",
      "Bash(security *)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Bash(halt *)",
      "Bash(brew install *)",
      "Bash(brew reinstall *)",
      "Bash(brew upgrade *)",
      "Bash(brew uninstall *)",
      "Bash(brew remove *)",
      "Bash(brew rm *)",
      "Bash(brew autoremove *)",
      "Bash(brew bundle *)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(~/Library/Keychains/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.cargo/credentials.toml)",
      "Read(~/.cargo/credentials)",
      "Edit(/.git/hooks/**)",
      "Edit(/.git/config)",
      "Edit(/.claude/settings.local.json)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "excludedCommands": [
      "gh api *",
      "gh issue *",
      "gh pr *",
      "gh project *",
      "gh label *",
      "gh search *",
      "gh auth status",
      "git push origin *",
      "git push -u origin *"
    ],
    "filesystem": {
      "allowWrite": ["~/.cargo/advisory-dbs"],
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.gnupg",
        "~/.config/gh",
        "~/Library/Keychains",
        "~/.netrc",
        "~/.git-credentials",
        "~/.cargo/credentials.toml",
        "~/.cargo/credentials"
      ]
    },
    "network": {
      "allowedDomains": ["github.com"]
    },
    "credentials": {
      "envVars": [
        { "name": "GH_TOKEN", "mode": "deny" },
        { "name": "GITHUB_TOKEN", "mode": "deny" },
        { "name": "GH_ENTERPRISE_TOKEN", "mode": "deny" },
        { "name": "CARGO_REGISTRY_TOKEN", "mode": "deny" }
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-push.sh\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
