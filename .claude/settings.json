{
  "permissions": {
    "allow": [
      "Bash(cargo xtask ci)",
      "Bash(cargo xtask ci --quick)",
      "Bash(cargo xtask test)",
      "Bash(cargo xtask test *)",
      "Bash(cargo xtask clippy)",
      "Bash(cargo xtask fmt --check)",
      "Bash(cargo xtask typos)",
      "Bash(cargo xtask doc)",
      "Bash(cargo xtask deny)",
      "Bash(cargo xtask check-workflows)",
      "Bash(cargo xtask check-docs)",
      "Bash(cargo xtask doctor)",
      "Bash(cargo xtask refs)"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(diskutil *)",
      "Bash(dd *)",
      "Bash(hdiutil *)",
      "Bash(launchctl *)",
      "Bash(tmutil *)",
      "Bash(csrutil *)",
      "Bash(nvram *)",
      "Bash(osascript *)",
      "Bash(security *)",
      "Bash(shutdown *)",
      "Bash(reboot *)",
      "Bash(halt *)",
      "Bash(brew install *)",
      "Bash(brew reinstall *)",
      "Bash(brew upgrade *)",
      "Bash(brew uninstall *)",
      "Bash(brew remove *)",
      "Bash(brew rm *)",
      "Bash(brew autoremove *)",
      "Bash(brew bundle *)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.config/gh/**)",
      "Read(~/Library/Keychains/**)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.cargo/credentials.toml)",
      "Read(~/.cargo/credentials)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-push.sh\"",
            "timeout": 120
          }
        ]
      }
    ]
  }
}
